#. type: Title =
#: en/foundations/modules/ROOT/pages/course-complete.adoc:1
#: en/intro-to-gbif/modules/ROOT/pages/course-complete.adoc:1
#, no-wrap
msgid "Course complete"
msgstr "課程完成"

#. type: Plain text
#: en/foundations/modules/ROOT/pages/course-complete.adoc:4
#: en/intro-to-gbif/modules/ROOT/pages/course-complete.adoc:4
msgid "You have now completed the course."
msgstr "你已經完成這門課程。"

#. type: Plain text
#: en/intro-to-gbif/modules/ROOT/pages/course-complete.adoc:7
msgid "As a reminder, this course serves as the prerequisite for other GBIF courses.  You only need to take the course one time, but you can of course refer back to the material at any time."
msgstr "提醒：本課程是修習其他GBIF課程的先修條件。只要修過一次即可，日後仍可隨時回來複習內容。"

#. type: Plain text
#: en/intro-to-gbif/modules/ROOT/pages/course-complete.adoc:8
msgid "Please complete this form to http://bit.ly/GBIFIntroComplete[register your completion^]."
msgstr "請填妥此表格，並將其寄至 http://bit.ly/GBIFIntroComplete[完成後請註冊^]。"

