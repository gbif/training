msgid "Exercise sheet"
msgstr "練習單"

#. type: Plain text
#: en/data-use/modules/ROOT/pages/exercise1.adoc:5
msgid "In this exercise, you will begin to work with https://dwc.tdwg.org/terms/[Darwin Core terms^] to determine which terms might be relevant for your use."
msgstr "在此練習中，您將開始使用 https://dwc.tdwg.org/terms/[Darwin Core 專有名詞^]，以確定哪些專有名詞可能與您的運用相關。"

#. type: Plain text
#: en/data-use/modules/ROOT/pages/exercise1.adoc:9
msgid "xref:attachment$Ex1_Darwin_Core.docx[Download Exercise 1] (MS Word 158 KB)"
msgstr "xref:attachment$Ex1_Darwin_Core.docx[下載練習 1] (MS Word 158 KB)"

#. type: Title ==
#: en/data-use/modules/ROOT/pages/exercise1.adoc:10
#: en/data-use/modules/ROOT/pages/exercise2.adoc:10
#: en/data-use/modules/ROOT/pages/exercise3.adoc:10
#: en/data-use/modules/ROOT/pages/exercise4.adoc:23
#: en/data-use/modules/ROOT/pages/exercise5.adoc:10
