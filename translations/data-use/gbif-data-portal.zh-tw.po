#. type: Title =
#: en/data-use/modules/ROOT/pages/gbif-data-portal.adoc:1
#, no-wrap
msgid "Using the GBIF data portal"
msgstr "使用 GBIF 資料入口網站"

#. type: Title ==
#: en/data-use/modules/ROOT/pages/gbif-data-portal.adoc:3
#, no-wrap
msgid "Species search"
msgstr "物種搜尋"

#. type: delimited block =
#: en/data-use/modules/ROOT/pages/gbif-data-portal.adoc:8
msgid "In this video (05:01), Cecilie Svenningsen, GBIF Data Administrator, demonstrates a species search on GBIF.org. If you are unable to watch the embedded Vimeo video, you can download it locally on the xref:downloads.adoc[Files for download] page."
msgstr "在這段影片（05:01）中，GBIF 資料管理員 Cecilie Svenningsen 示範了如何在 GBIF.org 上搜尋物種。若您無法觀看嵌入的 Vimeo 影片，可至 xref:downloads.adoc[可下載檔案] 頁面將影片下載至本機。"

#. type: Title ==
#: en/data-use/modules/ROOT/pages/gbif-data-portal.adoc:13
#, no-wrap
msgid "Occurrence search"
msgstr "出現紀錄搜尋"

#. type: delimited block =
#: en/data-use/modules/ROOT/pages/gbif-data-portal.adoc:18
msgid "In this video (08:25), Cecilie Svenningsen, GBIF Data Administrator, demonstrates an occurrence search on GBIF.org. If you are unable to watch the embedded Vimeo video, you can download it locally on the xref:downloads.adoc[Files for download] page."
msgstr "在這段影片（08:25）中，GBIF 資料管理員 Cecilie Svenningsen 示範了如何在 GBIF.org 上搜尋物種出現紀錄。若您無法觀看嵌入的 Vimeo 影片，可至 xref:downloads.adoc[可下載檔案] 頁面將影片下載至本機。"

#. type: Title ==
#: en/data-use/modules/ROOT/pages/gbif-data-portal.adoc:23
#, no-wrap
msgid "Spatial search"
msgstr "空間搜尋"

#. type: delimited block =
#: en/data-use/modules/ROOT/pages/gbif-data-portal.adoc:28
msgid "In this video (03:38),Cecilie Svenningsen, GBIF Data Administrator, demonstrates a spatial search on GBIF.org. If you are unable to watch the embedded Vimeo video, you can download it locally on the xref:downloads.adoc[Files for download] page."
msgstr "在這段影片（03:38）中，GBIF 資料管理員 Cecilie Svenningsen 示範了如何在 GBIF.org 上進行空間搜尋。若您無法觀看嵌入的 Vimeo 影片，可至 xref:downloads.adoc[可下載檔案] 頁面將影片下載至本機。"

