#. type: Title =
#: en/data-use/modules/ROOT/pages/software.adoc:1
#, no-wrap
msgid "Software and accounts"
msgstr "軟體與帳戶"

#. type: Plain text
#: en/data-use/modules/ROOT/pages/software.adoc:4
msgid "In order to complete this course, you will need to complete the following:"
msgstr "若要完成本課程，您需要完成以下事項："

#. type: Plain text
#: en/data-use/modules/ROOT/pages/software.adoc:6
msgid "Create an account on GBIF.org (if you don’t already have one). https://www.gbif.org/user/profile"
msgstr "請在 GBIF.org 上建立帳號（若您尚未擁有帳號）。https://www.gbif.org/user/profile"

#. type: delimited block =
#: en/data-use/modules/ROOT/pages/software.adoc:7
#: en/nodes/modules/ROOT/pages/gnt-efficient-data-access-data-reporting.adoc:47
msgid "Install R. https://www.r-project.org/"
msgstr "安裝 R 程式語言。https://www.r-project.org/"

#. type: delimited block =
#: en/data-use/modules/ROOT/pages/software.adoc:8
#: en/nodes/modules/ROOT/pages/gnt-efficient-data-access-data-reporting.adoc:48
msgid "Install R Studio Desktop. https://posit.co/download/rstudio-desktop/"
msgstr "安裝 RStudio Desktop。https://posit.co/download/rstudio-desktop/"

#. type: Plain text
#: en/data-use/modules/ROOT/pages/software.adoc:10
msgid "xref:attachment$RequiredSoftware_R.pdf[Download installation instructions] (846 KB)"
msgstr "xref:attachment$RequiredSoftware_R.pdf[下載安裝說明] (846 KB)"

#. type: Plain text
#: en/data-use/modules/ROOT/pages/software.adoc:11
msgid "Installation instructions reference earlier versions of the R and R Studio Desktop. Please install the most current and stable versions."
msgstr "此安裝說明所參考的是 R 及 R Studio Desktop 的較早版本。請安裝最新且穩定的版本。"

