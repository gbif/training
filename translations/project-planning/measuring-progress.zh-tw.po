#: en/project-planning/modules/ROOT/pages/measuring-progress.adoc:104
#, no-wrap
msgid "project-planning::mp6.png"
msgstr "project-planning::mp6.png"

#. type: delimited block =
#: en/project-planning/modules/ROOT/pages/measuring-progress.adoc:107
#, no-wrap
msgid "*Slide 6 - Examples of additional non-mandatory binary indicators*\n"
msgstr "*投影片6 — 其他非必要之二元指標的範例*\n"

#. type: delimited block =
#: en/project-planning/modules/ROOT/pages/measuring-progress.adoc:109
msgid "Examples of additional *non-mandatory binary indicators* to demonstrate the impact of data mobilization activities:"
msgstr "以下為：展示資料流通活動影響的額外 *非必要二元指標* 範例："

#. type: delimited block =
#: en/project-planning/modules/ROOT/pages/measuring-progress.adoc:111
#, no-wrap
msgid "*BINARY*\n"
msgstr "*二元*\n"

#. type: delimited block =
#: en/project-planning/modules/ROOT/pages/measuring-progress.adoc:113
msgid "Promotion of the use of GBIF-Mediated data for Research"
msgstr "推動利用 GBIF 提供資料來進行研究"

#. type: delimited block =
#: en/project-planning/modules/ROOT/pages/measuring-progress.adoc:114
msgid "Contribution to the development of local, national, and/or regional policies relating to environment"
msgstr "對地方、國家及／或區域層級環境相關政策之制定的貢獻"

#. type: delimited block =
#: en/project-planning/modules/ROOT/pages/measuring-progress.adoc:115
msgid "Promotion of open biodiversity approaches within the business and finance sector"
msgstr "在商界及金融界推廣開放式的生物多樣性方案"

#. type: delimited block =
#: en/project-planning/modules/ROOT/pages/measuring-progress.adoc:116
msgid "Contribution to establishing or strengthening collaborations to support the implementation of biodiversity-related multilateral environment agreements"
msgstr "協助建立或加強合作關係，以支持與生物多樣性相關的多邊環境協議之落實"

